# SPA: qualquer rota que nao seja arquivo real cai no index.html
# Sem isso, /unidades/alphaville da 404 ao recarregar ou ao abrir o link direto.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>
