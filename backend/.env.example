# Copie para .env e troque TODAS as senhas. O .env nunca vai pro git.
# Senhas: so letras e numeros (evita problema de aspas nos scripts).
# Gerar uma: openssl rand -hex 24

# dev | prod  (prod liga cookie Secure e HSTS)
APP_ENV=dev

# Chave secreta pra "embaralhar" IP/e-mail no rate limit (sem guardar o
# dado cru). Gerar: openssl rand -hex 32
APP_CHAVE_HMAC=troque_por_64_caracteres_hex

# Chave que criptografa o segredo do MFA no banco. Gerar: openssl rand -hex 32
# Se perder/trocar, todo MFA precisa ser ligado de novo (bin/mfa.php).
APP_CHAVE_MFA=troque_por_64_caracteres_hex

# Banco
DB_HOST=db
DB_PORT=3306
DB_NAME=academia24

# Usuario da aplicacao: so SELECT/INSERT/UPDATE/DELETE
DB_USER=academia_app
DB_PASS=troque_esta_senha_app

# Usuario das migrations: pode criar/alterar tabelas.
# Em producao NAO fica no .env do servidor (ver README).
DB_MIGRA_USER=academia_migra
DB_MIGRA_PASS=troque_esta_senha_migra

# So o Docker usa
DB_ROOT_PASS=troque_esta_senha_root
PHP_VERSION=8.3
DB_VERSION=11.4
