# Pasta da API (na Hostinger: public_html/api/).
# Regra: SO arquivo .php com nome simples responde. Qualquer outra coisa que
# parar aqui (backup.zip, notas.txt, grades.php.bak, _ajudante.php) da 403.
# Convencao: arquivo que comeca com "_" nunca e rota publica.

Options -Indexes

# Erro aqui dentro (404 nao existe, 403 proibido) = resposta curta do proprio
# Apache. Sem isto vale o ErrorDocument do .htaccess do site, e a API
# devolveria o index.html inteiro junto com o 404.
ErrorDocument 404 default
ErrorDocument 403 default

Require all denied
<FilesMatch "^[a-z0-9-]+\.php$">
  Require all granted
</FilesMatch>
